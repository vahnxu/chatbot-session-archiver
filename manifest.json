{
  "manifest_version": 3,
  "name": "Local Chatbot Session Archiver",
  "version": "0.1.0",
  "description": "Manually export the current AI chatbot session and exposed attachments to a local folder.",
  "key": "",
  "action": {
    "default_title": "Save chatbot session"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "popup.html",
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
